vec4 dfsky_sunTexture(vec2 uv) {
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);
    ivec2 pixel = min(ivec2(floor(uv * 32.0)), ivec2(31));
    int index = pixel.x + pixel.y * 32;
    uint texelWord = DFSKY_SUN_PIXELS[index / 4];
    uint paletteIndex = (texelWord >> (uint(index % 4) * 8u)) & 255u;
    uint rgba = DFSKY_SUN_PALETTE[paletteIndex];
    return vec4(uvec4(rgba & 255u, (rgba >> 8u) & 255u, (rgba >> 16u) & 255u, rgba >> 24u)) / 255.0;
}

