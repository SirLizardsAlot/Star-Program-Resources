// Color/brightness keyframes are copied from the same official 26.2 native
// day timeline used by the original fixed-time build. Inputs wrap at 24000.
vec4 dfsky_track_sky_color(float tick) {
    float t = tick < 133.0000000000 ? tick + 24000.0 : tick;
    if (t < 11867.0000000000) {
        return mix(vec4(1.0000000000, 1.0000000000, 1.0000000000, 1.0000000000), vec4(1.0000000000, 1.0000000000, 1.0000000000, 1.0000000000),
            (t - 133.0000000000) / 11734.0000000000);
    }
    if (t < 13670.0000000000) {
        return mix(vec4(1.0000000000, 1.0000000000, 1.0000000000, 1.0000000000), vec4(0.0000000000, 0.0000000000, 0.0000000000, 1.0000000000),
            (t - 11867.0000000000) / 1803.0000000000);
    }
    if (t < 22330.0000000000) {
        return mix(vec4(0.0000000000, 0.0000000000, 0.0000000000, 1.0000000000), vec4(0.0000000000, 0.0000000000, 0.0000000000, 1.0000000000),
            (t - 13670.0000000000) / 8660.0000000000);
    }
    return mix(vec4(0.0000000000, 0.0000000000, 0.0000000000, 1.0000000000), vec4(1.0000000000, 1.0000000000, 1.0000000000, 1.0000000000),
        (t - 22330.0000000000) / 1803.0000000000);
}

