float dfsky_track_star_brightness(float tick) {
    float t = tick < 92.0000000000 ? tick + 24000.0 : tick;
    if (t < 627.0000000000) {
        return mix(0.0370000000, 0.0000000000,
            (t - 92.0000000000) / 535.0000000000);
    }
    if (t < 11373.0000000000) {
        return mix(0.0000000000, 0.0000000000,
            (t - 627.0000000000) / 10746.0000000000);
    }
    if (t < 11732.0000000000) {
        return mix(0.0000000000, 0.0160000000,
            (t - 11373.0000000000) / 359.0000000000);
    }
    if (t < 11959.0000000000) {
        return mix(0.0160000000, 0.0440000000,
            (t - 11732.0000000000) / 227.0000000000);
    }
    if (t < 12399.0000000000) {
        return mix(0.0440000000, 0.1430000000,
            (t - 11959.0000000000) / 440.0000000000);
    }
    if (t < 12729.0000000000) {
        return mix(0.1430000000, 0.2580000000,
            (t - 12399.0000000000) / 330.0000000000);
    }
    if (t < 13228.0000000000) {
        return mix(0.2580000000, 0.5000000000,
            (t - 12729.0000000000) / 499.0000000000);
    }
    if (t < 22772.0000000000) {
        return mix(0.5000000000, 0.5000000000,
            (t - 13228.0000000000) / 9544.0000000000);
    }
    if (t < 23032.0000000000) {
        return mix(0.5000000000, 0.3640000000,
            (t - 22772.0000000000) / 260.0000000000);
    }
    if (t < 23356.0000000000) {
        return mix(0.3640000000, 0.2250000000,
            (t - 23032.0000000000) / 324.0000000000);
    }
    if (t < 23758.0000000000) {
        return mix(0.2250000000, 0.1010000000,
            (t - 23356.0000000000) / 402.0000000000);
    }
    return mix(0.1010000000, 0.0370000000,
        (t - 23758.0000000000) / 334.0000000000);
}

float dfsky_bezierCubic(float t, float a, float b) {
    float inverseT = 1.0 - t;
    return 3.0 * inverseT * inverseT * t * a + 3.0 * inverseT * t * t * b + t * t * t;
}

float dfsky_celestialEase(float x) {
    if (x <= 0.0) return 0.0;
    if (x >= 1.0) return 1.0;
    float low = 0.0;
    float high = 1.0;
    for (int i = 0; i < 32; ++i) {
        float middle = (low + high) * 0.5;
        if (dfsky_bezierCubic(middle, 0.362, 0.638) < x) low = middle;
        else high = middle;
    }
    return dfsky_bezierCubic((low + high) * 0.5, 0.241, 0.759);
}

void dfsky_setTime(float ticks) {
    float tick = isnan(ticks) || isinf(ticks) ? 6000.0 : mod(ticks, 24000.0);
    dfskyState.timeTicks = tick;
    dfskyState.sunAngle = dfsky_celestialEase(mod(tick - 6000.0, 24000.0) / 24000.0) * 6.283185307179586;
    dfskyState.starBrightness = dfsky_track_star_brightness(tick);
    dfskyState.skyColor = vec3(120.0, 167.0, 255.0) / 255.0 * dfsky_track_sky_color(tick).rgb;
    vec3 fog = vec3(192.0, 216.0, 255.0) / 255.0 * dfsky_track_fog_color(tick).rgb;
    dfskyState.fogColor = mix(fog, dfskyState.skyColor, DFSKY_FOG_BLEND);
    dfskyState.cloudColor = vec4(1.0, 1.0, 1.0, 0.8) * dfsky_track_cloud_color(tick);
    dfskyState.sunsetColor = dfsky_track_sunrise_sunset_color(tick);
}
